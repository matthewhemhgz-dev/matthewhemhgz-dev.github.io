---
import BrandLogo from './BrandLogo.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from '../LanguageToggle.astro';
import '../../styles/components/navigation.css';
import '../../styles/utilities/glass.css';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const isEnglish = currentPath.startsWith('/en');

const navItems = [
  { label: isEnglish ? 'Home' : '首页', href: isEnglish ? '/en' : '/' },
  { label: isEnglish ? 'About' : '关于', href: isEnglish ? '/en/about' : '/about' },
  { label: isEnglish ? 'Blog' : '博客', href: isEnglish ? '/en/blog' : '/blog' },
  { label: isEnglish ? 'Projects' : '项目', href: isEnglish ? '/en/projects' : '/projects' },
  { label: isEnglish ? 'Tags' : '标签', href: isEnglish ? '/en/tags' : '/tags' },
];
---

<header class="nav-wrapper" transition:name="main-nav">
  <nav class="nav qi-glass-nav" aria-label={isEnglish ? 'Main Navigation' : '主导航'}>
    <div class="nav-left">
      <BrandLogo variant="icon" size="sm" />
    </div>

    <!-- Mobile checkbox hack -->
    <input
      type="checkbox"
      id="nav-toggle"
      class="nav-toggle-input"
      aria-label={isEnglish ? 'Toggle navigation menu' : '切换导航菜单'}
      aria-expanded="false"
      aria-controls="nav-links"
    />

    <label
      for="nav-toggle"
      class="nav-toggle-label"
      aria-hidden="true"
      touch-action="manipulation"
      tabindex="-1"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </label>
    <div id="nav-status" class="sr-only" aria-live="polite"></div>

    <ul id="nav-links" class="nav-links" role="menubar">
      {
        navItems.map((item) => (
          <li role="none">
            <a
              href={item.href}
              class:list={[
                'nav-link',
                {
                  active:
                    currentPath === item.href ||
                    (item.href !== '/' && currentPath.startsWith(item.href)),
                },
              ]}
              touch-action="manipulation"
              role="menuitem"
              aria-current={
                currentPath === item.href ||
                (item.href !== '/' && currentPath.startsWith(item.href))
                  ? 'page'
                  : undefined
              }
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li role="none">
        <button
          class="nav-search-btn"
          id="nav-search-btn"
          aria-label={isEnglish ? 'Search articles (Ctrl+K)' : '搜索文章 (Ctrl+K)'}
          type="button"
          touch-action="manipulation"
          role="menuitem"
        >
          <svg width="16" height="16" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M12 12l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
            ></path>
          </svg>
          <span class="nav-search-label">{isEnglish ? 'Search' : '搜索'}</span>
          <kbd class="nav-search-kbd">⌘K</kbd>
        </button>
      </li>
      <li class="nav-close-item" role="none">
        <button
          class="nav-close-btn"
          aria-label={isEnglish ? 'Close navigation menu' : '关闭导航菜单'}
          type="button"
          touch-action="manipulation"
          role="menuitem"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            ></path>
            <path d="M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            ></path>
          </svg>
          <span>{isEnglish ? 'Close' : '关闭'}</span>
        </button>
      </li>
    </ul>

    <div class="nav-right">
      <!-- RSS Feed -->
      <a
        href={isEnglish ? '/en/rss.xml' : '/rss.xml'}
        class="nav-icon-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={isEnglish ? 'RSS Feed' : 'RSS 订阅'}
        title={isEnglish ? 'RSS Feed' : 'RSS 订阅'}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9"/>
          <path d="M4 4a16 16 0 0 1 16 16"/>
          <circle cx="5" cy="19" r="1"/>
        </svg>
      </a>

      <!-- Theme toggle -->
      <ThemeToggle />

      <!-- Language toggle -->
      <LanguageToggle />
    </div>
    <label for="nav-toggle" class="nav-backdrop" aria-hidden="true" tabindex="-1"></label>
  </nav>
</header>

<script>
  function getFocusableMenuItems(): HTMLElement[] {
    const navLinks = document.getElementById('nav-links');
    if (!navLinks) return [];
    const focusableElements = navLinks.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
    );
    return Array.from(focusableElements).filter(
      (el) => el.offsetParent !== null && !el.hasAttribute('aria-hidden')
    );
  }

  function focusFirstMenuItem() {
    const focusableItems = getFocusableMenuItems();
    if (focusableItems.length > 0) {
      setTimeout(() => focusableItems[0].focus(), 50);
    }
  }

  function closeMenuAndReturnFocus() {
    const navToggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
    const navStatus = document.getElementById('nav-status');
    const isEn = document.documentElement.lang.startsWith('en');
    if (navToggle) {
      navToggle.checked = false;
      navToggle.setAttribute('aria-expanded', 'false');
      if (navStatus) {
        navStatus.textContent = isEn ? 'Navigation menu closed' : '导航菜单已关闭';
      }
      navToggle.focus();
    }
  }

  function handleFocusTrap(e: KeyboardEvent) {
    if (e.key !== 'Tab') return;

    const focusableItems = getFocusableMenuItems();
    if (focusableItems.length === 0) return;

    const firstElement = focusableItems[0];
    const lastElement = focusableItems[focusableItems.length - 1];
    const activeElement = document.activeElement as HTMLElement;

    if (e.shiftKey) {
      if (activeElement === firstElement || !focusableItems.includes(activeElement)) {
        e.preventDefault();
        lastElement.focus();
      }
    } else {
      if (activeElement === lastElement || !focusableItems.includes(activeElement)) {
        e.preventDefault();
        firstElement.focus();
      }
    }
  }

  const navToggleInit = document.getElementById('nav-toggle');
  if (navToggleInit) {
    navToggleInit.setAttribute('aria-expanded', String(navToggleInit.checked));
  }

  const navItems = document.querySelectorAll('#nav-links li');
  navItems.forEach((item, index) => {
    item.style.setProperty('--nav-item-index', index);
  });

  const navStatus = document.getElementById('nav-status');
  if (navToggleInit) {
    navToggleInit.addEventListener('change', () => {
      const isOpen = navToggleInit.checked;
      const isEn = document.documentElement.lang.startsWith('en');
      navToggleInit.setAttribute('aria-expanded', String(isOpen));
      if (navStatus) {
        navStatus.textContent = isOpen
          ? isEn
            ? 'Navigation menu opened'
            : '导航菜单已打开'
          : isEn
            ? 'Navigation menu closed'
            : '导航菜单已关闭';
      }
      if (isOpen) {
        focusFirstMenuItem();
      }
    });
  }

  document.addEventListener('astro:page-load', () => {
    const navItems = document.querySelectorAll('#nav-links li');
    navItems.forEach((item, index) => {
      item.style.setProperty('--nav-item-index', index);
    });

    const closeBtn = document.querySelector('.nav-close-btn');
    closeBtn?.addEventListener('click', () => {
      closeMenuAndReturnFocus();
    });

    const searchBtn = document.getElementById('nav-search-btn');
    const searchModal = document.getElementById('search-modal');
    searchBtn?.addEventListener('click', () => {
      searchModal?.setAttribute('aria-hidden', 'false');
      setTimeout(() => {
        const searchInput = document.getElementById('search-input') as HTMLInputElement;
        searchInput?.focus();
      }, 100);
    });

    const navLinks = document.getElementById('nav-links');
    if (navLinks) {
      navLinks.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          e.preventDefault();
          closeMenuAndReturnFocus();
        } else {
          handleFocusTrap(e);
        }
      });
    }

    const navWrapper = document.querySelector('.nav-wrapper');
    const navToggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
    let ticking = false;

    function updateNav() {
      const isMenuOpen = navToggle?.checked || false;
      if (isMenuOpen) {
        ticking = false;
        return;
      }

      const scrollY = window.scrollY;
      const isMobile = window.innerWidth <= 768;
      
      if (scrollY > 100) {
        if (!isMobile) {
          navWrapper?.classList.add('nav-collapsed');
        }
        navWrapper?.classList.add('scrolled');
      } else {
        navWrapper?.classList.remove('nav-collapsed');
        navWrapper?.classList.remove('scrolled');
      }
      
      ticking = false;
    }

    const scrollHandler = () => {
      if (!ticking) {
        requestAnimationFrame(updateNav);
        ticking = true;
      }
    };

    const resizeHandler = () => {
      const scrollY = window.scrollY;
      const isMobile = window.innerWidth <= 768;
      
      if (isMobile) {
        navWrapper?.classList.remove('nav-collapsed');
      } else if (scrollY > 100) {
        navWrapper?.classList.add('nav-collapsed');
      }
    };

    window.addEventListener('scroll', scrollHandler);
    window.addEventListener('resize', resizeHandler);

    (window as any).__navCleanup = () => {
      window.removeEventListener('scroll', scrollHandler);
      window.removeEventListener('resize', resizeHandler);
    };
  });

  document.addEventListener('astro:before-swap', () => {
    if ((window as any).__navCleanup) {
      (window as any).__navCleanup();
      delete (window as any).__navCleanup;
    }
  });
</script>
