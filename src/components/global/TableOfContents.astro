---
import '../../styles/components/table-of-contents.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  label?: string;
}

const { headings, label = '目录' } = Astro.props;

const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filteredHeadings.length > 0 && (
  <>
    <aside class="toc-sidebar" aria-label={label}>
      <nav class="toc-nav">
        <div class="toc-header">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M4 2h8M4 8h8M4 14h5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
          <span class="toc-title">{label}</span>
        </div>
        <ul class="toc-list" role="list">
          {filteredHeadings.map((heading) => (
            <li
              class:list={['toc-item', `toc-item--depth-${heading.depth}`]}
              data-heading-slug={heading.slug}
            >
              <a href={`#${heading.slug}`} class="toc-link">
                <span class="toc-indicator"></span>
                <span class="toc-text">{heading.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <button class="toc-mobile-toggle" aria-label={label} aria-expanded="false" aria-controls="toc-mobile-sheet">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M4 5h12M4 10h12M4 15h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
      <span class="toc-mobile-count">{filteredHeadings.length}</span>
    </button>

    <div class="toc-mobile-sheet" id="toc-mobile-sheet" aria-hidden="true">
      <div class="toc-mobile-backdrop"></div>
      <div class="toc-mobile-content" role="dialog" aria-label={label}>
        <div class="toc-mobile-header">
          <div class="toc-mobile-header-left">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 2h8M4 8h8M4 14h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <span>{label}</span>
          </div>
          <button class="toc-mobile-close" aria-label="关闭目录">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
        <nav class="toc-mobile-nav">
          <ul class="toc-mobile-list" role="list">
            {filteredHeadings.map((heading) => (
              <li
                class:list={['toc-mobile-item', `toc-item--depth-${heading.depth}`]}
                data-heading-slug={heading.slug}
              >
                <a href={`#${heading.slug}`} class="toc-mobile-link">
                  <span class="toc-indicator"></span>
                  <span class="toc-text">{heading.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </>
)}

<script>
  let tocScrollHandler: (() => void) | null = null;
  const tocClickHandlers: Map<Element, (_e: Event) => void> = new Map();

  const tocMobileHandlers = (() => {
    let toggleBtn: HTMLButtonElement | null = null;
    let closeBtn: HTMLButtonElement | null = null;
    let backdrop: HTMLDivElement | null = null;
    let sheet: HTMLDivElement | null = null;
    let isOpen = false;

    function openSheet() {
      if (!sheet || !toggleBtn) return;
      isOpen = true;
      sheet.classList.add('is-open');
      sheet.setAttribute('aria-hidden', 'false');
      toggleBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      const firstLink = sheet.querySelector('.toc-mobile-link') as HTMLElement;
      if (firstLink) {
        setTimeout(() => firstLink.focus(), 300);
      }
    }

    function closeSheet() {
      if (!sheet || !toggleBtn) return;
      isOpen = false;
      sheet.classList.remove('is-open');
      sheet.setAttribute('aria-hidden', 'true');
      toggleBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      toggleBtn.focus();
    }

    function handleToggle(e: Event) {
      e.preventDefault();
      if (isOpen) {
        closeSheet();
      } else {
        openSheet();
      }
    }

    function handleClose(e: Event) {
      e.preventDefault();
      closeSheet();
    }

    function handleBackdropClick(e: Event) {
      if (e.target === backdrop) {
        closeSheet();
      }
    }

    function handleKeydown(e: KeyboardEvent) {
      if (!isOpen) return;
      if (e.key === 'Escape') {
        closeSheet();
      }
    }

    function init() {
      toggleBtn = document.querySelector('.toc-mobile-toggle');
      closeBtn = document.querySelector('.toc-mobile-close');
      backdrop = document.querySelector('.toc-mobile-backdrop');
      sheet = document.querySelector('.toc-mobile-sheet');

      if (!toggleBtn || !closeBtn || !backdrop || !sheet) return;

      toggleBtn.addEventListener('click', handleToggle);
      closeBtn.addEventListener('click', handleClose);
      backdrop.addEventListener('click', handleBackdropClick);
      document.addEventListener('keydown', handleKeydown);
    }

    function cleanup() {
      if (toggleBtn) toggleBtn.removeEventListener('click', handleToggle);
      if (closeBtn) closeBtn.removeEventListener('click', handleClose);
      if (backdrop) backdrop.removeEventListener('click', handleBackdropClick);
      document.removeEventListener('keydown', handleKeydown);
      document.body.style.overflow = '';
    }

    return { init, cleanup };
  })();

  function cleanupTableOfContents() {
    if (tocScrollHandler) {
      window.removeEventListener('scroll', tocScrollHandler);
      tocScrollHandler = null;
    }
    tocClickHandlers.forEach((handler, link) => {
      link.removeEventListener('click', handler);
    });
    tocClickHandlers.clear();
    tocMobileHandlers.cleanup();
  }

  function initTableOfContents() {
    if (tocScrollHandler) {
      window.removeEventListener('scroll', tocScrollHandler);
    }
    tocClickHandlers.forEach((handler, link) => {
      link.removeEventListener('click', handler);
    });
    tocClickHandlers.clear();
    tocMobileHandlers.init();

    const tocItems = document.querySelectorAll('.toc-item');
    const tocLinks = document.querySelectorAll('.toc-link');
    const mobileItems = document.querySelectorAll('.toc-mobile-item');
    const mobileLinks = document.querySelectorAll('.toc-mobile-link');

    if (tocItems.length === 0) return;

    const headingElements = Array.from(tocItems)
      .map((item) => {
        const slug = item.getAttribute('data-heading-slug');
        return slug ? document.getElementById(slug) : null;
      })
      .filter((el): el is HTMLElement => el !== null);

    if (headingElements.length === 0) return;

    let activeItem: Element | null = null;

    function updateActiveHeading() {
      const scrollPosition = window.scrollY;
      const viewportHeight = window.innerHeight;
      const offset = viewportHeight * 0.3;

      let currentHeading: HTMLElement | null = null;

      for (let i = headingElements.length - 1; i >= 0; i--) {
        const heading = headingElements[i];
        if (heading) {
          const rect = heading.getBoundingClientRect();
          const absoluteTop = rect.top + scrollPosition;

          if (scrollPosition >= absoluteTop - offset) {
            currentHeading = heading;
            break;
          }
        }
      }

      if (currentHeading) {
        const slug = currentHeading.getAttribute('id');
        const desktopItem = document.querySelector(
          `.toc-item[data-heading-slug="${slug}"]`
        );
        const mobileItem = document.querySelector(
          `.toc-mobile-item[data-heading-slug="${slug}"]`
        );

        if (desktopItem && desktopItem !== activeItem) {
          if (activeItem) {
            activeItem.classList.remove('active');
          }
          desktopItem.classList.add('active');
          if (mobileItem) {
            mobileItem.classList.add('active');
          }
          activeItem = desktopItem;

          const tocList = document.querySelector('.toc-list');
          const activeLink = desktopItem.querySelector('.toc-link');
          if (tocList && activeLink) {
            const listRect = tocList.getBoundingClientRect();
            const linkRect = activeLink.getBoundingClientRect();

            if (linkRect.top < listRect.top || linkRect.bottom > listRect.bottom) {
              activeLink.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }
          }
        }
      } else if (activeItem) {
        activeItem.classList.remove('active');
        const slug = activeItem.getAttribute('data-heading-slug');
        if (slug) {
          const mobileItem = document.querySelector(
            `.toc-mobile-item[data-heading-slug="${slug}"]`
          );
          if (mobileItem) mobileItem.classList.remove('active');
        }
        activeItem = null;
      }
    }

    let ticking = false;

    tocScrollHandler = () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateActiveHeading();
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', tocScrollHandler, { passive: true });
    updateActiveHeading();

    function handleLinkClick(e: Event) {
      e.preventDefault();
      const link = e.currentTarget as HTMLAnchorElement;
      const href = link.getAttribute('href');
      if (href) {
        const targetId = href.substring(1);
        const targetElement = document.getElementById(targetId);
        if (targetElement) {
          const navHeight = 80;
          const targetPosition = targetElement.getBoundingClientRect().top + window.scrollY - navHeight;

          window.scrollTo({
            top: targetPosition,
            behavior: 'smooth',
          });

          history.pushState(null, '', href);
          tocMobileHandlers.cleanup();
        }
      }
    }

    tocLinks.forEach((link) => {
      const clickHandler = handleLinkClick;
      link.addEventListener('click', clickHandler);
      tocClickHandlers.set(link, clickHandler);
    });

    mobileLinks.forEach((link) => {
      const clickHandler = handleLinkClick;
      link.addEventListener('click', clickHandler);
    });
  }

  document.addEventListener('astro:page-load', initTableOfContents);
  document.addEventListener('astro:before-swap', cleanupTableOfContents);
</script>
