---
/**
 * SocialQRModal — 社交媒体二维码弹窗
 *
 * 用于在点击微信、小红书、抖音等社交链接时显示二维码
 * 支持通过自定义事件 'open-social-qr' 唤起
 */
---

<div
  id="social-qr-modal"
  class="social-qr-modal"
  role="dialog"
  aria-labelledby="qr-modal-title"
  aria-hidden="true"
  aria-modal="true"
  transition:persist
>
  <div class="social-qr-backdrop" id="social-qr-backdrop" tabindex="-1" aria-hidden="true"></div>
  <div class="social-qr-container" role="document">
    <button type="button" class="social-qr-close" id="social-qr-close" aria-label="Close">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="social-qr-header">
      <h2 id="qr-modal-title" class="social-qr-title">Scan to Follow</h2>
      <p id="qr-modal-platform" class="social-qr-platform">Platform</p>
    </div>

    <div class="social-qr-image-wrap">
      <img id="social-qr-img" src="" alt="QR Code" class="social-qr-image" />
    </div>

    <div class="social-qr-footer">
      <span class="social-qr-hint" id="social-qr-hint">Scan or save image</span>
      <span id="social-qr-account" class="social-qr-account">Account Name</span>
    </div>
  </div>
</div>

<style>
  @import '../../styles/components/social-qr-modal.css';
</style>

<script>
  let lastFocusedElement: HTMLElement | null = null;

  function getFocusableElements(modal: HTMLElement): HTMLElement[] {
    const focusableSelectors = 'button, a[href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
    const focusableElements = modal.querySelectorAll<HTMLElement>(focusableSelectors);
    return Array.from(focusableElements).filter(el => {
      const isHidden = el.hasAttribute('aria-hidden') && el.getAttribute('aria-hidden') === 'true';
      const isDisabled = el.hasAttribute('disabled');
      const isHiddenByStyle = el.offsetParent === null;
      return !isHidden && !isDisabled && !isHiddenByStyle;
    });
  }

  function initSocialModal() {
    const modal = document.getElementById('social-qr-modal');
    const backdrop = document.getElementById('social-qr-backdrop');
    const closeBtn = document.getElementById('social-qr-close');
    const qrImg = document.getElementById('social-qr-img') as HTMLImageElement;
    const platformEl = document.getElementById('qr-modal-platform');
    const accountEl = document.getElementById('social-qr-account');

    if (!modal || !qrImg || !platformEl || !accountEl) return;

    function openModal(data: { platform: string; qrImage: string; account: string }, triggerElement?: HTMLElement | null) {
      const isEn = document.documentElement.lang.startsWith('en');

      if (triggerElement) {
        lastFocusedElement = triggerElement;
      }

      qrImg.src = data.qrImage;
      platformEl!.textContent = data.platform;
      accountEl!.textContent = data.account;

      const titleEl = document.getElementById('qr-modal-title');
      const hintEl = document.getElementById('social-qr-hint');
      if (titleEl) titleEl.textContent = isEn ? 'Scan to Follow' : '扫码关注';
      if (hintEl) hintEl.textContent = isEn ? 'Scan or save image' : '手机截屏或扫码识别';
      if (closeBtn) closeBtn.setAttribute('aria-label', isEn ? 'Close' : '关闭弹窗');

      modal!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      setTimeout(() => {
        closeBtn?.focus({ preventScroll: true });
      }, 50);
    }

    function closeModal() {
      modal!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';

      setTimeout(() => {
        if (lastFocusedElement) {
          lastFocusedElement.focus();
          lastFocusedElement = null;
        }
      }, 50);

      setTimeout(() => {
        if (modal!.getAttribute('aria-hidden') === 'true') {
          qrImg.src = '';
        }
      }, 300);
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest('[data-qr-trigger]');
      if (trigger) {
        e.preventDefault();
        const platform = trigger.getAttribute('data-platform');
        const qrImage = trigger.getAttribute('data-qr-image');
        const account = trigger.getAttribute('data-account');

        openModal({
          platform: platform || '',
          qrImage: qrImage || '',
          account: account || '',
        }, trigger as HTMLElement);
      }
    });

    window.addEventListener('open-social-qr', ((e: CustomEvent) => {
      if (e.detail) {
        lastFocusedElement = document.activeElement as HTMLElement;
        openModal(e.detail);
      }
    }) as EventListener);

    backdrop?.addEventListener('click', closeModal);
    closeBtn?.addEventListener('click', closeModal);

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal!.getAttribute('aria-hidden') === 'false') {
        closeModal();
      }
    });

    modal!.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') {
        const focusableElements = getFocusableElements(modal!);
        if (focusableElements.length === 0) return;

        const firstElement = focusableElements[0];
        const lastElement = focusableElements[focusableElements.length - 1];
        const activeElement = document.activeElement as HTMLElement;

        if (e.shiftKey) {
          if (activeElement === firstElement || !focusableElements.includes(activeElement)) {
            e.preventDefault();
            lastElement.focus();
          }
        } else {
          if (activeElement === lastElement || !focusableElements.includes(activeElement)) {
            e.preventDefault();
            firstElement.focus();
          }
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initSocialModal);
</script>
