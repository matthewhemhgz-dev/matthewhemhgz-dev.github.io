---
interface Props {
  type?: 'particles' | 'morphing' | 'pulse' | 'logo';
  duration?: number;
  classList?: string;
}

const {
  type = 'particles',
  duration = 2000,
  classList = '',
} = Astro.props;

const animationId = `loading-anim-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  class:list={['loading-animation', `loading-animation--${type}`, classList]}
  data-animation-id={animationId}
  data-duration={duration}
  role="status"
  aria-label="加载中"
>
  {type === 'particles' && (
    <div class="loading-particles">
      {[...Array(12)].map((_, i) => (
        <div class="loading-particle" style={`--particle-delay: ${i * 0.1}s`}></div>
      ))}
    </div>
  )}
  
  {type === 'morphing' && (
    <div class="loading-morphing">
      <div class="morphing-shape"></div>
    </div>
  )}
  
  {type === 'pulse' && (
    <div class="loading-pulse">
      <div class="pulse-ring pulse-ring--1"></div>
      <div class="pulse-ring pulse-ring--2"></div>
      <div class="pulse-ring pulse-ring--3"></div>
    </div>
  )}
  
  {type === 'logo' && (
    <div class="loading-logo">
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
        <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="2" opacity="0.2" />
        <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="2" stroke-dasharray="126" stroke-dashoffset="126" class="logo-circle" />
        <text x="24" y="28" text-anchor="middle" font-size="16" font-weight="bold" fill="currentColor" class="logo-text">祈</text>
      </svg>
    </div>
  )}
  
  <span class="loading-sr-only">加载中...</span>
</div>

<style>
  .loading-animation {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 120px;
  }

  .loading-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Particles Animation */
  .loading-particles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  .loading-particle {
    width: 12px;
    height: 12px;
    background: var(--qi-brand-emerald);
    border-radius: 50%;
    animation: particle-pulse 1.2s ease-in-out infinite;
    animation-delay: var(--particle-delay);
  }

  @keyframes particle-pulse {
    0%, 100% {
      transform: scale(0.8);
      opacity: 0.5;
    }
    50% {
      transform: scale(1.2);
      opacity: 1;
    }
  }

  /* Morphing Animation */
  .loading-morphing {
    width: 60px;
    height: 60px;
  }

  .morphing-shape {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--qi-brand-emerald), var(--qi-brand-mint));
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    animation: morphing 2s ease-in-out infinite;
  }

  @keyframes morphing {
    0%, 100% {
      border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
      transform: rotate(0deg);
    }
    25% {
      border-radius: 58% 42% 75% 25% / 76% 46% 54% 24%;
    }
    50% {
      border-radius: 50% 50% 33% 67% / 55% 27% 73% 45%;
      transform: rotate(180deg);
    }
    75% {
      border-radius: 33% 67% 58% 42% / 63% 68% 32% 37%;
    }
  }

  /* Pulse Animation */
  .loading-pulse {
    position: relative;
    width: 80px;
    height: 80px;
  }

  .pulse-ring {
    position: absolute;
    inset: 0;
    border: 2px solid var(--qi-brand-emerald);
    border-radius: 50%;
    animation: pulse-expand 1.5s ease-out infinite;
  }

  .pulse-ring--1 {
    animation-delay: 0s;
  }

  .pulse-ring--2 {
    animation-delay: 0.5s;
  }

  .pulse-ring--3 {
    animation-delay: 1s;
  }

  @keyframes pulse-expand {
    0% {
      transform: scale(0.5);
      opacity: 1;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  /* Logo Animation */
  .loading-logo {
    color: var(--qi-brand-emerald);
  }

  .logo-circle {
    animation: logo-draw 2s ease-in-out infinite;
  }

  @keyframes logo-draw {
    0% {
      stroke-dashoffset: 126;
    }
    50% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: -126;
    }
  }

  .logo-text {
    animation: logo-fade 2s ease-in-out infinite;
  }

  @keyframes logo-fade {
    0%, 100% {
      opacity: 0.5;
    }
    50% {
      opacity: 1;
    }
  }

  /* Dark Mode */
  :global(.dark) .loading-particle {
    background: var(--qi-brand-emerald);
  }

  :global(.dark) .morphing-shape {
    background: linear-gradient(135deg, var(--qi-brand-emerald), var(--qi-brand-mint));
  }

  :global(.dark) .pulse-ring {
    border-color: var(--qi-brand-emerald);
  }

  :global(.dark) .loading-logo {
    color: var(--qi-brand-emerald);
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .loading-particle,
    .morphing-shape,
    .pulse-ring,
    .logo-circle,
    .logo-text {
      animation: none;
    }

    .morphing-shape {
      border-radius: 50%;
    }

    .logo-circle {
      stroke-dashoffset: 0;
    }
  }
</style>
