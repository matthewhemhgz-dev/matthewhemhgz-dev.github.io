---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/sections/error.css';

const isEnglish = true;

const labels = {
  title: 'Offline - No Internet Connection',
  description: 'You are currently offline. Some features may be unavailable.',
  heading: 'You Are Offline',
  message: "It seems you have lost your internet connection. Don't worry, some content may still be available from your cache.",
  backHome: 'Back to Home',
  retry: 'Retry Connection',
  tips: 'Tips for getting back online',
  tip1: 'Check your Wi-Fi or data connection',
  tip2: 'Try refreshing the page',
  tip3: 'Come back later when connected',
};

const homeHref = '/en';
---

<BaseLayout title={labels.title} description={labels.description}>
  <div class="error-page">
    <div class="error-bg" aria-hidden="true">
      <div class="error-orb error-orb--1"></div>
      <div class="error-orb error-orb--2"></div>
      <div class="error-orb error-orb--3"></div>
    </div>

    <div class="error-container">
      <div class="error-main">
        <div class="error-illustration" aria-hidden="true">
          <svg width="200" height="200" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="100" cy="100" r="80" stroke="currentColor" stroke-width="1.5" stroke-dasharray="8 8" opacity="0.3"/>
            <circle cx="100" cy="100" r="50" stroke="currentColor" stroke-width="1" opacity="0.2"/>
            <path d="M60 140L100 80L140 140" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="100" cy="70" r="8" fill="currentColor" opacity="0.5"/>
            <line x1="100" y1="85" x2="100" y2="110" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <line x1="85" y1="130" x2="115" y2="130" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <circle cx="40" cy="60" r="3" fill="currentColor" opacity="0.3"/>
            <circle cx="160" cy="140" r="4" fill="currentColor" opacity="0.3"/>
            <circle cx="150" cy="50" r="2" fill="currentColor" opacity="0.4"/>
            <circle cx="50" cy="150" r="3" fill="currentColor" opacity="0.4"/>
          </svg>
        </div>
        <div class="error-badge">// OFFLINE</div>
        <h1 class="error-title">{labels.heading}</h1>
        <p class="error-message">
          {labels.message}
        </p>

        <div class="error-actions">
          <a href={homeHref} class="error-btn error-btn--primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            {labels.backHome}
          </a>
          <button id="retry-btn" class="error-btn error-btn--secondary" onclick="window.location.reload()">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 4 23 10 17 10"></polyline>
              <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
            </svg>
            {labels.retry}
          </button>
        </div>

        <div class="offline-tips">
          <h3>{labels.tips}</h3>
          <ul>
            <li>{labels.tip1}</li>
            <li>{labels.tip2}</li>
            <li>{labels.tip3}</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="error-particles" aria-hidden="true">
      <div class="error-particle"></div>
      <div class="error-particle"></div>
      <div class="error-particle"></div>
      <div class="error-particle"></div>
      <div class="error-particle"></div>
    </div>
  </div>
</BaseLayout>

<style>
  .offline-tips {
    margin-top: 2rem;
    padding: 1.5rem;
    background: var(--qi-card-bg, rgba(42, 42, 42, 0.05));
    border-radius: 12px;
    border: 1px solid var(--qi-card-border, rgba(42, 42, 42, 0.08));
  }

  .offline-tips h3 {
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--qi-text-secondary, #666);
  }

  .offline-tips ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .offline-tips li {
    font-size: 0.875rem;
    color: var(--qi-text-tertiary, #888);
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
  }

  .offline-tips li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: var(--qi-accent, #2563eb);
  }
</style>
