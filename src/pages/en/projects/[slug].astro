---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { projects } from '../../../data/projects';
import OptimizedImage from '../../../components/ui/OptimizedImage.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://matthewhemhgz-dev.github.io';
const projectUrl = `${siteUrl}/en/projects/${project.slug}/`;

const projectJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Project',
  name: project.titleEn,
  description: project.descriptionEn,
  url: projectUrl,
  image: `${siteUrl}${project.image}`,
  dateCreated: `${project.year}-01-01`,
  author: {
    '@type': 'Person',
    name: 'Qi-Lab',
    url: siteUrl,
  },
  keywords: project.tags.join(', '),
  programmingLanguage: project.tags,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}/en/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Projects',
      item: `${siteUrl}/en/projects/`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: project.titleEn,
      item: projectUrl,
    },
  ],
};
---

<BaseLayout
  title={`${project.titleEn} | Qi-Lab`}
  description={project.descriptionEn}
  ogImage={project.image}
  ogImageWidth={1200}
  ogImageHeight={675}
  ogType="article"
  jsonLd={projectJsonLd}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  
  <Breadcrumb 
    items={[
      { label: 'Home', url: '/en' },
      { label: 'Projects', url: '/en/projects' },
      { label: project.titleEn, url: `/en/projects/${project.slug}/`, isCurrent: true }
    ]} 
  />

  <div class="project-detail-page">
    <div class="container">
      <a href="/en/projects" class="back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Back to Projects</span>
      </a>

      <article class="project-detail">
        <header class="project-header">
          <div class="project-category">
            <span class="category-tag">{project.categoryEn}</span>
          </div>
          
          <h1 class="project-title">{project.titleEn}</h1>
          
          <p class="project-description">{project.descriptionEn}</p>

          <div class="project-meta-info">
            <div class="meta-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              <span>{project.year}</span>
            </div>
          </div>
        </header>

        <div class="project-image-section">
          <OptimizedImage
            src={project.image}
            alt={project.titleEn}
            width={1200}
            height={675}
            loading="eager"
            class="project-hero-image"
          />
        </div>

        {project.featuresEn && project.featuresEn.length > 0 && (
          <section class="project-features">
            <h2 class="section-title">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <polyline points="9 11 12 14 22 4"/>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
              </svg>
              Key Features
            </h2>
            <ul class="feature-list">
              {project.featuresEn.map((feature) => (
                <li class="feature-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="project-tech-stack">
          <h2 class="section-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/>
            </svg>
            Tech Stack
          </h2>
          <div class="tech-tags">
            {project.tags.map((tag) => (
              <span class="tech-tag">{tag}</span>
            ))}
          </div>
        </section>

        <section class="project-links">
          <h2 class="section-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
            Links
          </h2>
          <div class="link-buttons">
            {project.url && (
              <a href={project.url} class="link-btn primary" target="_blank" rel="noopener noreferrer">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
                {project.url === '/' ? 'Visit Website' : 'View Details'}
              </a>
            )}
            {project.github && (
              <a href={project.github} class="link-btn secondary" target="_blank" rel="noopener noreferrer">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
                </svg>
                GitHub
              </a>
            )}
          </div>
        </section>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
.project-detail-page {
  padding: var(--qi-space-3xl) 0 var(--qi-space-5xl);
  min-height: 80vh;
  background: linear-gradient(180deg, var(--qi-bg-base) 0%, var(--qi-bg-surface) 100%);
}

.container {
  max-width: var(--qi-container-max);
  margin: 0 auto;
  padding: 0 var(--qi-container-padding);
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: var(--qi-space-xs);
  color: var(--qi-text-secondary);
  text-decoration: none;
  font-size: var(--qi-text-sm);
  margin-bottom: var(--qi-space-xl);
  transition: all var(--qi-transition);
}

.back-link:hover {
  color: var(--qi-brand-emerald);
  transform: translateX(-4px);
}

.project-detail {
  background: var(--qi-bg-surface);
  border-radius: var(--qi-card-border-radius);
  padding: var(--qi-space-3xl);
  box-shadow: var(--qi-card-shadow-base);
  border: var(--qi-card-border);
}

.project-header {
  text-align: center;
  margin-bottom: var(--qi-space-3xl);
}

.project-category {
  margin-bottom: var(--qi-space-md);
}

.category-tag {
  display: inline-block;
  padding: var(--qi-space-xs) var(--qi-space-lg);
  background: var(--qi-brand-emerald-04);
  color: var(--qi-brand-emerald);
  border-radius: var(--qi-radius-full);
  font-size: var(--qi-text-sm);
  font-weight: 600;
}

.project-title {
  font-family: var(--qi-font-serif);
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: var(--qi-weight-bold);
  color: var(--qi-text-primary);
  margin-bottom: var(--qi-space-lg);
  line-height: 1.2;
}

.project-description {
  font-size: var(--qi-text-lg);
  color: var(--qi-text-secondary);
  max-width: 700px;
  margin: 0 auto var(--qi-space-xl);
  line-height: 1.8;
}

.project-meta-info {
  display: flex;
  justify-content: center;
  gap: var(--qi-space-xl);
}

.meta-item {
  display: flex;
  align-items: center;
  gap: var(--qi-space-xs);
  color: var(--qi-text-muted);
  font-size: var(--qi-text-sm);
  font-family: var(--qi-font-mono);
}

.project-image-section {
  margin-bottom: var(--qi-space-3xl);
  border-radius: var(--qi-radius-lg);
  overflow: hidden;
}

.project-hero-image {
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  display: block;
}

.section-title {
  display: flex;
  align-items: center;
  gap: var(--qi-space-sm);
  font-family: var(--qi-font-serif);
  font-size: var(--qi-text-xl);
  font-weight: var(--qi-weight-semibold);
  color: var(--qi-text-primary);
  margin-bottom: var(--qi-space-xl);
}

.section-title svg {
  color: var(--qi-brand-emerald);
}

.project-features {
  margin-bottom: var(--qi-space-3xl);
  padding: var(--qi-space-xl);
  background: var(--qi-surface-sub);
  border-radius: var(--qi-radius-lg);
}

.feature-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: var(--qi-space-md);
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: var(--qi-space-sm);
  font-size: var(--qi-text-base);
  color: var(--qi-text-secondary);
  line-height: 1.6;
}

.feature-item svg {
  flex-shrink: 0;
  margin-top: 2px;
  color: var(--qi-brand-emerald);
}

.project-tech-stack {
  margin-bottom: var(--qi-space-3xl);
}

.tech-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--qi-space-sm);
}

.tech-tag {
  padding: var(--qi-space-sm) var(--qi-space-lg);
  background: var(--qi-bg-surface);
  border: 1px solid var(--qi-border-default);
  border-radius: var(--qi-radius-full);
  font-size: var(--qi-text-sm);
  font-family: var(--qi-font-mono);
  color: var(--qi-text-secondary);
  transition: all var(--qi-transition);
}

.tech-tag:hover {
  border-color: var(--qi-brand-emerald);
  color: var(--qi-brand-emerald);
}

.project-links {
  padding-top: var(--qi-space-xl);
  border-top: 1px solid var(--qi-border-subtle);
}

.link-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: var(--qi-space-md);
}

.link-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--qi-space-sm);
  padding: var(--qi-space-md) var(--qi-space-xl);
  border-radius: var(--qi-radius-full);
  font-size: var(--qi-text-base);
  font-weight: var(--qi-weight-semibold);
  text-decoration: none;
  transition: all var(--qi-transition);
}

.link-btn.primary {
  background: var(--qi-brand-emerald);
  color: var(--qi-text-inverse);
}

.link-btn.primary:hover {
  opacity: 0.9;
  transform: translateY(-2px);
  box-shadow: var(--qi-shadow-lg);
}

.link-btn.secondary {
  background: var(--qi-surface-sub);
  color: var(--qi-text-primary);
  border: 1px solid var(--qi-border-default);
}

.link-btn.secondary:hover {
  background: var(--qi-border-default);
  transform: translateY(-2px);
}

@media (max-width: 768px) {
  .project-detail-page {
    padding: var(--qi-space-xl) 0 var(--qi-space-3xl);
  }

  .project-detail {
    padding: var(--qi-space-xl);
  }

  .project-header {
    margin-bottom: var(--qi-space-xl);
  }

  .project-title {
    font-size: 1.75rem;
  }

  .project-description {
    font-size: var(--qi-text-base);
  }

  .project-image-section {
    margin-bottom: var(--qi-space-xl);
  }

  .project-features,
  .project-tech-stack {
    margin-bottom: var(--qi-space-xl);
    padding: var(--qi-space-lg);
  }

  .section-title {
    font-size: var(--qi-text-lg);
  }

  .link-buttons {
    flex-direction: column;
  }

  .link-btn {
    justify-content: center;
  }
}
</style>
