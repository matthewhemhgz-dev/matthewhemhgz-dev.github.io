---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo from '../components/global/BrandLogo.astro';
import '../styles/sections/error.css';
import { getCollection } from 'astro:content';

const currentLocale = Astro.url.pathname.startsWith('/en') ? 'en' : 'zh';
const isEnglish = currentLocale === 'en';

const allPosts = await getCollection('blog', ({ data }) => !data.draft && data.lang === currentLocale);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const labels = isEnglish
  ? {
      title: '404 - Page Not Found',
      description: 'The page you are looking for does not exist.',
      code: '404',
      heading: 'Lost in the Digital Void',
      message:
        "Don't worry, even the best explorers sometimes take a wrong turn. Let's find your way back.",
      backHome: 'Back to Home',
      browseBlog: 'Browse Blog',
      searchBtn: 'Search',
      searchPlaceholder: 'Search articles...',
      navTitle: 'Quick Navigation',
      home: 'Home',
      blog: 'Blog',
      projects: 'Projects',
      about: 'About',
      tags: 'Tags',
      recommended: 'Recommended Reading',
      exploreMore: 'Explore More Content',
      lostSvg: `<svg width="200" height="200" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="100" cy="100" r="80" stroke="currentColor" stroke-width="1.5" stroke-dasharray="8 8" opacity="0.3"/>
        <circle cx="100" cy="100" r="50" stroke="currentColor" stroke-width="1" opacity="0.2"/>
        <path d="M100 50V80L130 100L100 120V150" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="100" cy="100" r="8" fill="currentColor" opacity="0.5"/>
        <circle cx="40" cy="60" r="3" fill="currentColor" opacity="0.3"/>
        <circle cx="160" cy="140" r="4" fill="currentColor" opacity="0.3"/>
        <circle cx="150" cy="50" r="2" fill="currentColor" opacity="0.4"/>
        <circle cx="50" cy="150" r="3" fill="currentColor" opacity="0.4"/>
        <circle cx="170" cy="80" r="2" fill="currentColor" opacity="0.3"/>
        <circle cx="30" cy="100" r="2" fill="currentColor" opacity="0.3"/>
      </svg>`,
    }
  : {
      title: '404 - 页面未找到',
      description: '您访问的页面不存在。',
      code: '404',
      heading: '迷失在数字空间',
      message: '别担心，即使是最资深的探索者也会偶尔走错路。让我们一起找到回去的路吧。',
      backHome: '返回首页',
      browseBlog: '浏览博客',
      searchBtn: '搜索',
      searchPlaceholder: '搜索文章...',
      navTitle: '快速导航',
      home: '首页',
      blog: '博客',
      projects: '项目',
      about: '关于',
      tags: '标签',
      recommended: '推荐阅读',
      exploreMore: '探索更多内容',
      lostSvg: `<svg width="200" height="200" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="100" cy="100" r="80" stroke="currentColor" stroke-width="1.5" stroke-dasharray="8 8" opacity="0.3"/>
        <circle cx="100" cy="100" r="50" stroke="currentColor" stroke-width="1" opacity="0.2"/>
        <path d="M100 50V80L130 100L100 120V150" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="100" cy="100" r="8" fill="currentColor" opacity="0.5"/>
        <circle cx="40" cy="60" r="3" fill="currentColor" opacity="0.3"/>
        <circle cx="160" cy="140" r="4" fill="currentColor" opacity="0.3"/>
        <circle cx="150" cy="50" r="2" fill="currentColor" opacity="0.4"/>
        <circle cx="50" cy="150" r="3" fill="currentColor" opacity="0.4"/>
        <circle cx="170" cy="80" r="2" fill="currentColor" opacity="0.3"/>
        <circle cx="30" cy="100" r="2" fill="currentColor" opacity="0.3"/>
      </svg>`,
    };

const homeHref = isEnglish ? '/en' : '/';
const blogHref = isEnglish ? '/en/blog' : '/blog';
const projectsHref = isEnglish ? '/en/projects' : '/projects';
const aboutHref = isEnglish ? '/en/about' : '/about';
const tagsHref = isEnglish ? '/en/tags' : '/tags';
---

<BaseLayout title={`${labels.title} | Qi-Lab`} description={labels.description}>
  <div class="error-page">
    <div class="error-bg" aria-hidden="true">
      <div class="error-orb error-orb--1"></div>
      <div class="error-orb error-orb--2"></div>
      <div class="error-orb error-orb--3"></div>
    </div>

    <div class="error-container">
      <div class="error-main">
        <div class="error-illustration" aria-hidden="true" set:html={labels.lostSvg}></div>
        <div class="error-badge">// {labels.code}</div>
        <span class="error-code">404</span>
        <h1 class="error-title">{labels.heading}</h1>
        <p class="error-message">
          {labels.message}
        </p>

        <div class="error-actions">
          <a href={homeHref} class="error-btn error-btn--primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            {labels.backHome}
          </a>
          <button id="error-search-btn" class="error-btn error-btn--search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            {labels.searchBtn}
          </button>
          <a href={blogHref} class="error-btn error-btn--secondary">{labels.browseBlog}</a>
        </div>
      </div>

      <aside class="error-sidebar">
        <div class="error-nav-card">
          <h2 class="error-nav-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
            </svg>
            {labels.navTitle}
          </h2>
          <nav class="error-nav-list" aria-label={labels.navTitle}>
            <a href={homeHref} class="error-nav-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
              {labels.home}
            </a>
            <a href={blogHref} class="error-nav-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
              {labels.blog}
            </a>
            <a href={projectsHref} class="error-nav-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
              {labels.projects}
            </a>
            <a href={aboutHref} class="error-nav-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
              {labels.about}
            </a>
            <a href={tagsHref} class="error-nav-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
              </svg>
              {labels.tags}
            </a>
          </nav>
        </div>

        {recentPosts.length > 0 && (
          <div class="error-recommend-card">
            <h2 class="error-recommend-title">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
              {labels.recommended}
            </h2>
            <ul class="error-recommend-list">
              {recentPosts.map((post) => (
                <li>
                  <a href={`${isEnglish ? '/en/blog' : '/blog'}/${post.id}`} class="error-recommend-item">
                    <span class="error-recommend-item-title">{post.data.title}</span>
                    <span class="error-recommend-item-arrow">→</span>
                  </a>
                </li>
              ))}
            </ul>
            <a href={blogHref} class="error-recommend-more">
              {labels.exploreMore}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        )}
      </aside>
    </div>

    <div class="error-particles" aria-hidden="true">
      <div class="error-particle"></div>
      <div class="error-particle"></div>
      <div class="error-particle"></div>
      <div class="error-particle"></div>
      <div class="error-particle"></div>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const searchBtn = document.getElementById('error-search-btn');
    searchBtn?.addEventListener('click', () => {
      const searchModal = document.getElementById('search-modal');
      if (searchModal) {
        searchModal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        const input = document.getElementById('search-input') as HTMLInputElement;
        setTimeout(() => input?.focus(), 50);
      }
    });
  });
</script>
